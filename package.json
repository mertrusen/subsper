{
  "name": "subsper",
  "productName": "Subsper",
  "version": "1.3.0",
  "description": "Subsper — AI subtitles, audio cleanup & silence cutting. By zipheron.",
  "main": "electron-main.js",
  "author": "zipheron",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "prep": "node scripts/fetch-binaries.mjs",
    "dist:win": "npm run prep && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run prep && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist": "electron-builder -mw --publish never",
    "cli": "node scripts/subsper-cli.mjs",
    "dist:mac:signed": "npm run prep && electron-builder --mac -c.mac.notarize=true --publish never",
    "dev:mac": "dev/run.sh"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zipheron.subsper",
    "productName": "Subsper",
    "files": [
      "electron-main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "scripts/**/*",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "PRIVACY.md"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "js/whispercpp.js",
        "to": "js/whispercpp.js"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Subsper-Setup-${version}.${ext}",
      "publisherName": "zipheron"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "Subsper-${version}-mac-arm64.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/bin/darwin-arm64/whisper-cli",
        "Contents/Resources/bin/darwin-arm64/ffmpeg"
      ]
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "mertrusen",
        "repo": "subsper"
      }
    ],
    "afterPack": "scripts/afterPack.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "electron-updater": "^6.3.9"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
